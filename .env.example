# llama.cpp local OpenAI-compatible server used by this lab.
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_API_KEY=

# Optional llama.cpp model-id overrides. Leave blank to use the canonical
# registry name. Set the matching value only when /v1/models intentionally
# advertises a different identity for the loaded model.
QWEN35_08B_LOCAL_MODEL=
QWEN35_2B_LOCAL_MODEL=
QWEN35_4B_LOCAL_MODEL=
QWEN35_9B_LOCAL_MODEL=
QWEN35_27B_LOCAL_MODEL=
QWEN35_35B_A3B_LOCAL_MODEL=
QWEN35_122B_A10B_LOCAL_MODEL=

# OpenRouter lane. Paid requests still require --allow-paid.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Optional provider-model overrides. The registry already contains the
# snapshot model ids used by the frontier5 matrix, so these can stay blank.
QWEN35_FRONTIER_MODEL=
GEMINI_3_FLASH_OPENROUTER_MODEL=
GROK_45_OPENROUTER_MODEL=
GPT56_SOL_OPENROUTER_MODEL=
CLAUDE_OPUS_5_OPENROUTER_MODEL=
CLAUDE_FABLE_5_OPENROUTER_MODEL=

# Optional direct OpenAI-compatible endpoint, outside frontier5.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_FRONTIER_MODEL=
