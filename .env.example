# llama.cpp local OpenAI-compatible server used by this lab.
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_API_KEY=

# Optional llama.cpp model-id overrides. Leave blank to use the canonical
# registry name. Set the matching value only if /v1/models advertises a
# different model id than the registry entry you are benchmarking.
QWEN35_08B_LOCAL_MODEL=
QWEN35_2B_LOCAL_MODEL=
QWEN35_4B_LOCAL_MODEL=
QWEN35_9B_LOCAL_MODEL=
QWEN35_27B_LOCAL_MODEL=
QWEN35_35B_A3B_LOCAL_MODEL=
QWEN35_122B_A10B_LOCAL_MODEL=

# Optional OpenRouter lane. No remote request is made unless --allow-paid is supplied.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Set these to exact provider slugs available to your OpenRouter account.
QWEN35_FRONTIER_MODEL=
CLAUDE_FABLE_5_OPENROUTER_MODEL=
CLAUDE_OPUS_5_OPENROUTER_MODEL=
GROK_46_OPENROUTER_MODEL=
GEMINI_37_FLASH_OPENROUTER_MODEL=

# Optional direct OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_FRONTIER_MODEL=
